{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ndndndn1.github.io/meeting-epistemic-gateway/meeting.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "appVersion": {
      "type": "string"
    },
    "speakers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Speaker"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "profileSnapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Speaker"
      }
    },
    "listeningState": {
      "enum": ["IDLE", "LISTENING", "PAUSED", "ENDED"]
    },
    "speakerHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SpeakerEdit"
      }
    }
  },
  "required": ["schemaVersion", "appVersion", "speakers", "claims", "evidence"],
  "additionalProperties": false,
  "$defs": {
    "SpeakerPolicyState": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["NORMAL", "EVIDENCE REQUIRED"]
        },
        "unsupported": {
          "type": "number",
          "minimum": 0
        },
        "calibrated": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["mode", "unsupported", "calibrated"],
      "additionalProperties": false
    },
    "Speaker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "embedding": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "baseline": {
          "$ref": "#/$defs/SpeakerPolicyState"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    },
    "Utterance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "speakerId": {
          "type": ["string", "null"]
        },
        "speakerCertain": {
          "type": "boolean"
        },
        "endedAt": {
          "type": "number",
          "minimum": 0
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "speakerId",
        "speakerCertain",
        "endedAt",
        "final"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "page": {
          "type": ["number", "null"]
        },
        "checkedAt": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "enum": ["CALCULATION", "MODEL_KNOWLEDGE", "DOCUMENT", "WEB"]
        },
        "documentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "text", "title", "source", "version", "checkedAt"],
      "additionalProperties": false
    },
    "Revision": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "EXPERIENCE",
            "HYPOTHESIS",
            "UNSUPPORTED ASSERTION",
            "CONTRADICTED",
            "UNVERIFIABLE",
            "PENDING",
            "QUESTION",
            "VALUE JUDGMENT",
            "PROPOSAL",
            "GENERAL_KNOWLEDGE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "enum": ["CALCULATION", "MODEL_KNOWLEDGE", "DOCUMENT", "WEB"]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["status", "reason", "at"],
      "additionalProperties": false
    },
    "Verdict": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "EXPERIENCE",
            "HYPOTHESIS",
            "UNSUPPORTED ASSERTION",
            "CONTRADICTED",
            "UNVERIFIABLE",
            "PENDING",
            "QUESTION",
            "VALUE JUDGMENT",
            "PROPOSAL",
            "GENERAL_KNOWLEDGE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checkedAt": {
          "type": "number",
          "minimum": 0
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Revision"
          }
        },
        "basis": {
          "enum": ["CALCULATION", "MODEL_KNOWLEDGE", "DOCUMENT", "WEB"]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "audioSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioSpan"
          }
        }
      },
      "required": ["status", "reason", "evidenceIds", "checkedAt", "revisions"],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "utteranceId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "speakerId": {
          "type": ["string", "null"]
        },
        "speakerCertain": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "EXPERIENCE",
            "HYPOTHESIS",
            "UNSUPPORTED ASSERTION",
            "CONTRADICTED",
            "UNVERIFIABLE",
            "PENDING",
            "QUESTION",
            "VALUE JUDGMENT",
            "PROPOSAL",
            "GENERAL_KNOWLEDGE"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "endedAt": {
          "type": "number",
          "minimum": 0
        },
        "checkedAt": {
          "type": "number",
          "minimum": 0
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Revision"
          }
        },
        "spoken": {
          "type": "boolean"
        },
        "basis": {
          "enum": ["CALCULATION", "MODEL_KNOWLEDGE", "DOCUMENT", "WEB"]
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attempt"
          }
        },
        "audioSpans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AudioSpan"
          }
        }
      },
      "required": [
        "id",
        "utteranceId",
        "text",
        "speakerId",
        "speakerCertain",
        "status",
        "reason",
        "evidenceIds",
        "endedAt",
        "checkedAt",
        "revisions",
        "spoken"
      ],
      "additionalProperties": false
    },
    "Intervention": {
      "type": "object",
      "properties": {
        "claimId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "expiresAt": {
          "type": "number",
          "minimum": 0
        },
        "interruptedOnce": {
          "type": "boolean"
        },
        "state": {
          "enum": ["QUEUED", "SPEAKING", "STOPPED", "EXPIRED", "DONE"]
        }
      },
      "required": ["claimId", "text", "expiresAt", "interruptedOnce", "state"],
      "additionalProperties": false
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "route": {
          "enum": ["CALCULATION", "LOCAL", "OPENROUTER"]
        },
        "reason": {
          "type": "string"
        },
        "startedAt": {
          "type": "number",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "type": "string"
        },
        "inputTokenUpperBound": {
          "type": "number",
          "minimum": 0
        },
        "retrievalMs": {
          "type": "number",
          "minimum": 0
        },
        "queueMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["route", "reason", "startedAt", "durationMs", "outcome"],
      "additionalProperties": false
    },
    "AudioSpan": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": ["uri", "file", "startMs", "endMs"],
      "additionalProperties": false
    },
    "SpeakerEdit": {
      "type": "object",
      "properties": {
        "at": {
          "type": "number",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": ["at", "kind", "id", "from", "to"],
      "additionalProperties": false
    }
  }
}
